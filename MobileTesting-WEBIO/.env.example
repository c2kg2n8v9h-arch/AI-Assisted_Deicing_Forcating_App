# Copy to .env for local use. Never commit real credentials.
TARGET_ENV=local
BASE_URL=
BROWSER=chrome
PROJECT_CONFIG=
SUITE=all
RUN_MODE=local
HEADLESS=false
MAX_INSTANCES=1
LOG_LEVEL=info
ALLOW_PRODUCTION=false

# Optional browser overrides for machines where automatic detection is unavailable.
CHROME_BINARY=
CHROMEDRIVER_PATH=
EDGE_BINARY=
EDGEDRIVER_PATH=
SPEC_GLOB=

# AI capabilities are optional and disabled by default.
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
